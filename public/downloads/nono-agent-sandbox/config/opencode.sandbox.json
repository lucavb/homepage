{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "webfetch": "allow"
    },
    "mcp": {
        "github": {
            "type": "remote",
            "url": "{env:GITHUB_MCP_BASE_URL}/mcp/readonly",
            "headers": {
                "Authorization": "Bearer {env:GITHUB_MCP_PAT}",
                "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
            }
        },
        "aws-mcp": {
            "type": "remote",
            "url": "http://127.0.0.1:59074/mcp"
        }
    },
    "tools": {
        "aws-mcp_*": false
    }
}
