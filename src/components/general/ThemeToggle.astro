---
interface Props {
    id?: string;
    class?: string;
    variant?: 'dropdown' | 'toggle';
}

const { id = 'theme-toggle', class: className = '', variant = 'dropdown' } = Astro.props;
---

{variant === 'dropdown' ? (
    <div class={`relative ${className}`}>
        <button
            id={id}
            class="flex size-10 items-center justify-center rounded-full border border-[var(--ink)] bg-transparent text-[var(--ink)] transition-colors hover:bg-[var(--ink)] hover:text-[var(--paper)]"
            aria-label="Toggle theme"
            aria-haspopup="true"
            aria-expanded="false"
        >
            <svg
                id={`${id}-icon`}
                data-theme-icon
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
            </svg>
        </button>

        <div
            id={`${id}-dropdown`}
            data-theme-dropdown
            class="absolute right-0 top-full z-50 mt-1 w-32 border border-[var(--ink)] bg-[var(--paper)] opacity-0 invisible transform scale-95 transition-all duration-150 overflow-hidden"
        >
            <div class="py-1" role="menu">
                <button
                    class="theme-option flex w-full items-center border-0 px-3 py-2 text-sm hover:bg-[var(--pale)] transition-colors"
                    data-theme="light"
                    role="menuitem"
                >
                    <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                        />
                    </svg>
                    Light
                </button>
                <button
                    class="theme-option flex w-full items-center border-0 px-3 py-2 text-sm hover:bg-[var(--pale)] transition-colors"
                    data-theme="dark"
                    role="menuitem"
                >
                    <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                        />
                    </svg>
                    Dark
                </button>
                <button
                    class="theme-option flex w-full items-center border-0 px-3 py-2 text-sm hover:bg-[var(--pale)] transition-colors"
                    data-theme="system"
                    role="menuitem"
                >
                    <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        />
                    </svg>
                    System
                </button>
            </div>
        </div>
    </div>
) : (
    <div id={id} class={`flex items-center border border-white/50 p-1 ${className}`}>
        <button
            class="theme-option flex size-8 items-center justify-center transition-all duration-200 text-[var(--paper)] hover:bg-white/15"
            data-theme="system"
            aria-label="System theme"
            aria-pressed="false"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
            </svg>
        </button>

        <button
            class="theme-option flex size-8 items-center justify-center transition-all duration-200 text-[var(--paper)] hover:bg-white/15"
            data-theme="light"
            aria-label="Light theme"
            aria-pressed="false"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                />
            </svg>
        </button>

        <button
            class="theme-option flex size-8 items-center justify-center transition-all duration-200 text-[var(--paper)] hover:bg-white/15"
            data-theme="dark"
            aria-label="Dark theme"
            aria-pressed="false"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                />
            </svg>
        </button>
    </div>
)}

<script>
    import { initTheme } from '@lib/theme';

    // Astro bundles one copy of this script per page; initTheme()'s default
    // root discovers every rendered ThemeToggle instance (header dropdown and
    // sidebar pill) and wires each against its own container.
    const wiring = () => initTheme();

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wiring);
    } else {
        wiring();
    }
</script>
